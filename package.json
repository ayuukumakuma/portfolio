{
	"name": "portfolio",
	"version": "0.1.0",
	"private": true,
	"packageManager": "pnpm@9.15.2",
	"engines": {
		"pnpm": "9.15.2"
	},
	"scripts": {
		"dev": "run-p dev:*",
		"dev:next": "next dev --turbo",
		"dev:hcm": "hcm 'src/**/*.module.css' --watch",
		"build": "next build",
		"start": "next start",
		"fix": "biome check --fix ./src/**/*",
		"check": "biome check ./src/**/*",
		"typecheck": "tsc --noEmit --diagnostics --pretty"
	},
	"dependencies": {
		"@tabler/icons-react": "3.26.0",
		"clsx": "2.1.1",
		"motion": "11.15.0",
		"next": "15.1.4",
		"react": "18.3.1",
		"react-dom": "18.3.1",
		"react-simple-typewriter": "5.0.1"
	},
	"devDependencies": {
		"@biomejs/biome": "1.9.4",
		"@types/node": "22.10.5",
		"@types/react": "18.3.12",
		"@types/react-dom": "18.3.0",
		"happy-css-modules": "3.2.0",
		"lefthook": "1.7.15",
		"npm-run-all2": "7.0.2",
		"postcss": "8.4.49",
		"typescript": "5.7.2"
	}
}
